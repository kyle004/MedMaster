{
  "rules": {
    "presence": {
      ".read": "auth != null",
      ".indexOn": ["lastSeen"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      ".indexOn": ["timestamp"]
    },
    "analytics": {
      "visits": {
        ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null",
        ".indexOn": ["timestamp"]
      },
      "sessions": {
        ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
        ".write": "auth != null",
        ".indexOn": ["userId", "timestamp"]
      }
    },
    "userStats": {
      ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "userMeta": {
      ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      ".indexOn": ["status", "signupAt"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.uid === $uid || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))",
        "status": {
          ".validate": "(auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true) || newData.val() === 'pending' || newData.val() === 'rejected' || (newData.val() === 'approved' && root.child('appConfig/siteConfig/auth/manualApprovalEnabled').val() !== true)"
        },
        "approvedBy": {
          ".validate": "(auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)"
        },
        "approvedAt": {
          ".validate": "(auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)"
        },
        "rejectedAt": {
          ".validate": "(auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)"
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt"]
    },
    "activityFeed": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },
    "userProgress": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "bannedUsers": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)"
    },
    "admins": {
      ".read": "auth != null",
      ".write": false
    },
    "appConfig": {
      "inviteCode": {
        ".read": true,
        ".write": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)"
      },
      "siteConfig": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)"
      },
      "aiConfig": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)"
      }
    },

    "userTiers": {
      ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)"
      }
    },

    "aiUsage": {
      ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))",
        "$day": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
        }
      }
    },

    "aiSpend": {
      ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      ".write": false,
      "$day": {
        ".indexOn": ["total6"]
      }
    },

    "codeblue": {
      "rooms": {
        ".read": "auth != null",
        ".indexOn": ["createdAt", "status"],
        "$roomId": {
          ".write": "auth != null",
          "state": {
            ".validate": "newData.hasChildren()"
          },
          "events": {
            "$eventId": {
              ".write": "auth != null && !data.exists()"
            }
          },
          "players": {
            "$uid": {
              ".write": "auth != null && (auth.uid === $uid || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))"
            }
          }
        }
      },
      "results": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "voiceCache": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      ".indexOn": ["createdAt"],
      "$hash": {
        ".write": "auth != null && (!data.exists() || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.hasChildren(['url','voiceId','modelId'])",
        "hits": { ".write": "auth != null" }
      }
    },

    "voiceSpend": {
      ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      ".write": false
    },

    "voiceUsage": {
      ".read": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))",
        "$day": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val())"
        }
      }
    },

    "imageCache": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true)",
      ".indexOn": ["feature", "createdAt"],
      "$hash": {
        ".write": "auth != null && (!data.exists() || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))",
        ".validate": "newData.hasChildren(['url','mime','model'])",
        "hits": { ".write": "auth != null" }
      }
    },

    "community": {
      "profiles": {
        ".read": "auth != null",
        "$uid": { ".write": "auth != null && (auth.uid === $uid || (auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true))" }
      },
      "questions": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["createdAt", "authorId", "status", "score"]
      },
      "scenarios": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["createdAt", "authorId", "status", "score"]
      },
      "threads": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["createdAt", "authorId", "lastReplyAt", "category"]
      },
      "comments": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$target": { ".indexOn": ["createdAt"] }
      },
      "decks": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["createdAt", "authorId", "score"]
      },
      "studyGroups": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["createdAt", "ownerId"]
      },
      "votes": {
        ".read": "auth != null",
        "$target": {
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        }
      },
      "activity": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".indexOn": ["timestamp"]
      },
      "stats": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "notifications": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null",
          ".indexOn": ["timestamp"]
        }
      },
      "reports": {
        ".read": "auth != null && ((auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null",
        ".indexOn": ["createdAt", "status"]
      },
      "moderationLog": {
        ".read": "auth != null && ((auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ((auth.token.email === 'codingky@gmail.com' && auth.token.email_verified === true) || root.child('admins').child(auth.uid).val() === true)",
        ".indexOn": ["timestamp"]
      }
    }
  }
}
